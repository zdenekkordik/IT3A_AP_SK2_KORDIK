class Robot:
    def __init__(self, oznaceni:str, baterie:int, ukol:str = "počítat"):
        self.oznaceni = oznaceni
        self.baterie = baterie
        self.ukol = ukol
        pass

    def zvuk(self):
        return"piip"

    def diagnostika(self):
        return f"Mé označení je {self.oznaceni} a moje baterka má {self.baterie}%"

    def aktivniUkol(self):
        return f"Můj aktivní úkol je momentálně {self.ukol}"

    def zadejUkol(self, nUkol:str):
        self.ukol = nUkol
        return f"Mojim novým úkolem je teď {nUkol}"

robot = Robot("T3H4", 74)
print(robot.zvuk())
print(robot.diagnostika())
print(robot.aktivniUkol())
print(robot.zadejUkol("spát"))

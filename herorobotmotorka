class Hero:
    def __init__(self, jmeno:str, lvl:int, lokace:str = "Les"):
        self.jmeno = jmeno
        self.lvl = lvl
        self.lokace = lokace
        pass

    def pokrik(self):
        return"hůůůů"

    def predstavSe(self):
        return f"Ahoj mé jméno je {hero.jmeno}"

    def kdeJsi(self):
        return f"Momentálně se nacházím v {self.lokace}"

    def presunSe(self, nLokace:str):
        self.lokace = nLokace
        return f"Přesunul jsem se na {nLokace}"

hero = Hero("Eugene",32)
print(hero.pokrik())
print(hero.predstavSe())
print(hero.kdeJsi())
